# Database (PostgreSQL on port 5433 — local Postgres usually occupies 5432)
DATABASE_URL=postgresql+asyncpg://menufinder:menufinder@localhost:5433/menufinder
DATABASE_URL_SYNC=postgresql://menufinder:menufinder@localhost:5433/menufinder

# External APIs
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Auth — generate a long random string (32+ chars) for production
JWT_SECRET=change-this-to-a-long-random-string-in-production

# App
DEBUG=true
